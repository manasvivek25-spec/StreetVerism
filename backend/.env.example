# StreetVerism Backend Environment Configuration
# Copy this file to .env or backend/.env and replace placeholders with secure values.

# Security: REQUIRED shared secret for authority endpoints (never commit real keys)
AUTHORITY_KEY=change-me

# CORS: Comma-separated list of allowed origins (or * for development)
CORS_ORIGINS=*

# Database: SQLite connection string (or Postgres in production)
DATABASE_URL=sqlite:///./streetverism.db

# Operating Mode: 1 for mock data mode, 0 for live data mode
MOCK=1
